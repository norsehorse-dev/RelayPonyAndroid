default_platform(:android)

before_all do
  Dotenv.overload("../.env") if File.exist?("../.env")
end

AAB = "app/build/outputs/bundle/release/app-release.aab"

def version_code
  File.read("../app/build.gradle.kts")[/versionCode\s*=\s*(\d+)/, 1].to_i
end

platform :android do
  desc "Capture raw screenshots from the debug build (one device or emulator connected), then frame them"
  lane :screenshots do
    sh("cd .. && tools/play-screenshots.sh")
    sh("cd .. && ${PYTHON:-$( [ -x .venv/bin/python ] && echo .venv/bin/python || echo python3 )} tools/frame-screenshots.py --platform android")
  end

  desc "Re-frame existing raw captures only (no device needed)"
  lane :frame do
    sh("cd .. && ${PYTHON:-$( [ -x .venv/bin/python ] && echo .venv/bin/python || echo python3 )} tools/frame-screenshots.py --platform android")
  end

  lane :bundle do
    gradle(task: "bundle", build_type: "Release", project_dir: ".")
  end

  desc "Upload listing text, graphics and screenshots to the closed track's current release"
  lane :metadata do |options|
    upload_to_play_store(
      track: options[:track] || "alpha",
      version_code: version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: false,
      sync_image_upload: true
    )
  end
end
