<?xml version="1.0" encoding="utf-8"?>
<!-- A4: declares RelayPony as a Direct Share target. Paired devices are published at runtime as
     dynamic sharing shortcuts (TransferController.refreshShareShortcuts) whose category matches
     the one below, so they surface as one-tap people-targets in any app's share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.relaypony.android.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.relaypony.android.directshare.SEND" />
    </share-target>
</shortcuts>
